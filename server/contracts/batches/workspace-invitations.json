      "source": "server/go/cmd/server/router.go",
      "handler_source": "server/go/internal/handler/invitation.go"
    },
    {
      "method": "GET",
      "path": "/api/invitations",
      "handler": "ListMyInvitations",
      "success_status": 200,
      "policy": "authenticated user",
      "source": "server/go/cmd/server/router.go",
      "handler_source": "server/go/internal/handler/invitation.go"
    },
    {
      "method": "GET",
      "path": "/api/invitations/{id}",
      "handler": "GetMyInvitation",
      "success_status": 200,
      "policy": "recipient",
      "source": "server/go/cmd/server/router.go",
      "handler_source": "server/go/internal/handler/invitation.go"
    },
    {
      "method": "POST",
      "path": "/api/invitations/{id}/accept",
