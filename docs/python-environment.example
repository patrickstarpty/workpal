# Explicitly export these variables in your shell; npm does not load this file.
WORKPAL_DATABASE_URL=sqlite:////absolute/path/to/workpal.sqlite
REDIS_URL=redis://127.0.0.1:26379
REDIS_KEY_PREFIX=workpal:local:
WORKPAL_HOST=127.0.0.1
WORKPAL_ENV=development
# Supply AUTH_SECRET via your secret manager (at least 32 bytes).
# Enable WORKPAL_DEV_AUTH=true only for local development login.
# npm start defaults to 4174; development uses web 4174 and API 4175.
# WORKPAL_PORT overrides the Python API/listening port in both modes.
# WORKPAL_WEB_PORT overrides the Vite port in development only.
