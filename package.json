{
  "name": "workpal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "node server/start.mjs --dev",
    "build": "pnpm --filter @workpal/web build",
    "typecheck": "turbo typecheck --filter=!@workpal/mobile",
    "test": "node --test server/*.test.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "lint": "turbo lint --filter=!@workpal/mobile",
    "knip": "knip",
    "check:ui-exports": "node scripts/check-ui-wildcard-exports.mjs",
    "check:ui-radii": "node scripts/check-ui-radius-tokens.mjs",
    "check:deps-catalog": "node scripts/check-dependency-catalog.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "theme:preview": "node scripts/theme-preview.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add",
    "generate:brand": "node scripts/brand/generate.mjs",
    "generate:attachment-text-preview": "node scripts/generate-attachment-text-preview.mjs",
    "generate:reserved-slugs": "node scripts/generate-reserved-slugs.mjs",
    "dev": "node server/start.mjs --dev",
    "start": "node server/start.mjs",
    "check": "node --check server/api.mjs && node --check server/store.mjs && npm test && npm run build",
    "prototype:check": "npm --prefix assets/workpal-prototype run check",
    "postinstall": "node scripts/ensure-app-layout.mjs",
    "dev:docs": "pnpm -C apps/docs dev",
    "build:docs": "pnpm -C apps/docs build",
    "storybook": "pnpm -C apps/storybook storybook",
    "build:storybook": "pnpm -C apps/storybook build-storybook"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@xmldom/xmldom": "^0.8.13",
      "postcss": "8.5.26",
      "uuid": "11.1.1",
      "shell-quote": "1.9.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@5>brace-expansion": "2.1.4",
      "minimatch@9>brace-expansion": "2.1.4",
      "minimatch@10>brace-expansion": "5.0.9",
      "builder-util-runtime": "9.7.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "knip": "^6.32.2",
    "pg": "^8.20.0",
    "postcss": "catalog:",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "@tanstack/react-query": "catalog:",
    "i18next": "catalog:",
    "react-i18next": "catalog:",
    "zustand": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "shadcn": "catalog:",
    "tw-animate-css": "catalog:",
    "@workpal/core": "workspace:*",
    "@workpal/views": "workspace:*",
    "@workpal/ui": "workspace:*"
  }
}
